{
  "model": "opus",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit(*)",
      "MultiEdit(*)",
      "Write(*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(source:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(git:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(which:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",
      "Bash(wc:*)",
      "Bash(env:*)",
      "Bash(npm:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(jest:*)",
      "Bash(next:*)",
      "Bash(next dev:*)",
      "Bash(next build:*)",
      "Bash(next start:*)",
      "Bash(tsc:*)",
      "Bash(playwright:*)",
      "Bash(cypress:*)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "Bash(./install.sh:*)",
      "Bash(../install.sh)",
      "Bash(bash:*)",
      "Bash(PRPS_TARGET_DIR=/tmp/test_install_target bash -x ./install.sh --overwrite-all)",
      "Bash(PRPS_TARGET_DIR=/tmp/test_install_target ./install.sh --overwrite-all)",
      "Bash(/tmp/debug_install.sh:*)",
      "Bash(PRPS_TARGET_DIR=/tmp/test_install_target timeout 10 ./install.sh --overwrite-all)",
      "Bash(PRPS_TARGET_DIR=/tmp/test_install_target timeout 30 ./install.sh --overwrite-all)",
      "Bash(timeout 5 cp -r /home/cryptox/code/context-engineering-nextjs/.claude /tmp/test_claude_copy)",
      "Bash(true)",
      "WebFetch(domain:appwrite.io)",
      "Bash(pkill:*)",
      "Bash(sudo apt:*)",
      "Bash(sudo apt install:*)",
      "Bash(~/.local/bin/yq:*)",
      "Bash(kill:*)",
      "Bash(for i in {1..3})",
      "Bash(do echo \"=== Run $i ===\")",
      "Bash(done)",
      "Bash(NODE_OPTIONS=\"--max-old-space-size=512\" npm test -- src/lib/indicators/parallel/__tests__/performance-benchmark.test.ts --run --reporter=basic)",
      "Bash(timeout 30s npm test:*)",
      "Bash(timeout 90s npm test:*)",
      "Bash(timeout 60s npm test:*)",
      "Bash(timeout 45s npm test -- --run --reporter=basic)",
      "Bash(ESLINT_NO_DEV_ERRORS=true npm run build)",
      "Bash(./scripts/lint-fix-all.sh:*)",
      "Bash(python3:*)",
      "Bash(timeout 600 npm run build)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ntfy-notifier.sh notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ntfy-notifier.sh stop"
          }
        ]
      }
    ]
  }
}